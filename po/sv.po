msgid "Decrease cutoff when pitch increases##decreasecutoff%d"
msgstr "Minska brytfrekvensen när tonhöjden ökar##decreasecutoff%d"

#: src/gui/insEdit/sid3.cpp:678
msgid ""
"If this is enabled,filter cutoff will decrease if you increase the pitch.\n"
"If this is disabled,filter cutoff will increase if you increase the pitch."
msgstr ""
"Om detta är aktiverat kommer filtrets brytfrekvens att minska om du ökar tonhöjden.\n"
"Om detta är inaktiverat kommer filtrets brytfrekvens att öka om du ökar tonhöjden."

#: src/gui/insEdit/sid3.cpp:683
#, c-format
msgid "Cutoff change center note##bindcutcenternote%d"
msgstr "Centernot för brytfrekvensändring##bindcutcenternote%d"

#: src/gui/insEdit/sid3.cpp:686
msgid ""
"The center note for cutoff changes. At this note no cutoff change happens.\n"
"As pitch goes lower or higher,cutoff changes apply."
msgstr ""
"Centernoten för brytfrekvensändringar. Vid denna not sker ingen ändring av brytfrekvensen.\n"
"När tonhöjden går lägre eller högre tillämpas brytfrekvensändringar."

#: src/gui/insEdit/sid3.cpp:689
#, c-format
msgid "Cutoff change strength##bindcutstrength%d"
msgstr "Styrka för brytfrekvensändring##bindcutstrength%d"

#: src/gui/insEdit/sid3.cpp:692
